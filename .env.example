# =============================================================
# Opony.app — przykładowe zmienne środowiskowe
#
# Każda aplikacja ma swój własny plik .env:
#   API     → apps/api/.env              (skopiuj sekcję API)
#   Panel   → apps/panel/.env.local      (skopiuj sekcję PANEL)
#   Mobile  → apps/mobile/.env           (skopiuj sekcję MOBILE)
# =============================================================


# ─────────────────────────────────────────────────────────────
# API — apps/api/.env
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://opony:opony_dev_password@localhost:5432/opony_dev
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PANEL_URL=http://localhost:3001
APP_URL=http://localhost:4000

# JWT — generuj: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_jwt_secret_here
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_here
ADMIN_JWT_SECRET=changeme_admin_jwt_here

# SMS (Twilio)
TWILIO_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE=placeholder
TWILIO_MOCK=true

# Email (Resend)
RESEND_API_KEY=placeholder
RESEND_FROM_EMAIL=noreply@opony.app

# Storage (AWS S3)
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_S3_BUCKET=opony-uploads
AWS_REGION=eu-central-1

# Maps
GOOGLE_MAPS_API_KEY=placeholder

# GUS (weryfikacja NIP)
GUS_API_KEY=placeholder
GUS_BASE_URL=https://dane.biznes.gov.pl/api/ceidg/v3

# Monitoring
SENTRY_DSN_API=placeholder

# Web Push (VAPID) — generuj: cd apps/api && npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=placeholder
VAPID_PRIVATE_KEY=placeholder
VAPID_SUBJECT=mailto:kontakt@opony.app

# Feature flags
CLIENT_LAUNCH_DATE=2026-05-14


# ─────────────────────────────────────────────────────────────
# Panel (B2B) — apps/panel/.env.local
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=placeholder   # musi być identyczny jak VAPID_PUBLIC_KEY
NEXT_PUBLIC_GOOGLE_MAPS_KEY=placeholder
SENTRY_DSN_PANEL=placeholder
NEXT_PUBLIC_POSTHOG_KEY=placeholder
POSTHOG_HOST=https://eu.posthog.com


# ─────────────────────────────────────────────────────────────
# Mobile — apps/mobile/.env
# ─────────────────────────────────────────────────────────────

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_MOCK=false
EXPO_PUBLIC_SENTRY_DSN=placeholder
GOOGLE_MAPS_API_KEY=placeholder


# ─────────────────────────────────────────────────────────────
# Landing — apps/landing/.env.local  (opcjonalne)
# ─────────────────────────────────────────────────────────────

SENTRY_DSN_LANDING=placeholder
