// ============================================================
//  opony.app — Prisma schema
//  BE-1a / Sprint 1
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum UserRole {
  CLIENT
  PROVIDER_OWNER
  PROVIDER_STAFF
  ADMIN
}

enum ProviderType {
  MOBILE
  STATIONARY
  BOTH
}

enum ProviderStatus {
  PENDING_NIP
  PENDING_DOCS
  PENDING_APPROVAL
  APPROVED
  SUSPENDED
  REJECTED
  PENDING_DELETION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_PROVIDER
  CANCELLED_BY_SYSTEM
  NO_SHOW
  REJECTED
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

enum EmailType {
  EMAIL_VERIFICATION
  EMAIL_CHANGE_OTP
  SUBMISSION_RECEIVED
  ACCOUNT_APPROVED
  ACCOUNT_REJECTED
}

enum ServiceType {
  SEASONAL_SWAP
  WHEEL_SWAP
  BALANCING
  PUNCTURE_REPAIR
}

enum ServicePricingType {
  FLAT       // stała cena — jeden wariant bez nazwy
  VARIANTS   // warianty z nazwą (np. Osobowe, SUV)
  RIM_SIZES  // zakresy rozmiarów felg
}

enum LeaveType {
  VACATION
  UNPAID
  SICK
  OTHER
}

enum WaitlistRole {
  CLIENT
  PROVIDER
}

enum DataExportStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum TireType {
  SUMMER
  WINTER
  ALL_SEASON
}

enum TireCondition {
  GOOD
  WORN
  CRITICAL
}

enum TireSetStatus {
  IN_DEPOT
  PICKED_UP
}

// ──────────────────────────────────────────────
// USER
// ──────────────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  phone        String    @unique @db.VarChar(20)
  email        String?   @unique @db.VarChar(254)
  role         UserRole  @default(CLIENT)
  firstName    String?   @db.VarChar(100)
  lastName     String?   @db.VarChar(100)
  noShowCount  Int       @default(0)
  isBanned     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  vehicles          Vehicle[]
  provider          Provider?              @relation("ProviderOwner")
  consentLogs       ConsentLog[]
  auditLogs         AuditLog[]
  sessions          Session[]
  clients           Client[]
  waitlistEntries   ProviderWaitlistEntry[]

  @@map("users")
}

// ──────────────────────────────────────────────
// CLIENT — klient warsztatu (per-provider CRM)
// ──────────────────────────────────────────────

model Client {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  phone      String   @db.VarChar(20)
  firstName  String?  @db.VarChar(100)
  lastName   String?  @db.VarChar(100)
  notes      String?  @db.Text
  userId     String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  bookings Booking[]
  reviews  Review[]
  tireSets TireSet[]

  @@unique([providerId, phone])
  @@index([providerId])
  @@index([providerId, lastName])
  @@map("clients")
}

// ──────────────────────────────────────────────
// VEHICLE (klient)
// ──────────────────────────────────────────────

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  nickname  String?  @db.VarChar(100)
  make      String?  @db.VarChar(100)
  model     String?  @db.VarChar(100)
  year      Int?
  tireSize  String   @db.VarChar(20)
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("VehicleBookings")

  @@index([userId])
  @@map("vehicles")
}

// ──────────────────────────────────────────────
// PROVIDER (firma)
// ──────────────────────────────────────────────

model Provider {
  id               String         @id @default(uuid()) @db.Uuid
  name             String         @db.VarChar(200)
  slug             String?        @unique @db.VarChar(100)
  nip              String         @unique @db.VarChar(10)
  type             ProviderType   @default(MOBILE)
  status           ProviderStatus @default(PENDING_NIP)
  description      String?        @db.Text
  logoUrl          String?        @db.VarChar(500)
  phone            String?        @db.VarChar(20)
  email            String?        @db.VarChar(254)
  ownerId          String         @unique @db.Uuid
  cityCenterLat    Decimal?       @db.Decimal(9, 6)
  cityCenterLng    Decimal?       @db.Decimal(9, 6)
  serviceRadiusKm  Int            @default(10)
  avgRating        Decimal        @default(0) @db.Decimal(3, 2)
  reviewCount      Int            @default(0)
  bankAccountIban  String?        @db.VarChar(34)
  tagline         String?        @db.VarChar(80)
  foundedYear     Int?
  showPhone       Boolean        @default(true)
  address         String?        @db.VarChar(300)
  vehicleTypes    String[]       @default([])
  tireSizes       String[]       @default([])
  additionalServices String[]    @default([])
  createdAt        DateTime       @default(now())
  submittedAt      DateTime?
  approvedAt            DateTime?
  deletionRequestedAt   DateTime?
  updatedAt             DateTime       @updatedAt

  emailVerifiedAt  DateTime?
  pausedUntil      DateTime?

  tpmsPricePln      Decimal? @db.Decimal(10,2)
  travelFeeZone1Pln Decimal  @default(0) @db.Decimal(10,2)
  travelFeeZone2Pln Decimal  @default(0) @db.Decimal(10,2)

  owner              User                       @relation("ProviderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  photos             ProviderPhoto[]
  scheduleExceptions ScheduleException[]
  bookings           Booking[]                  @relation("ProviderBookings")
  reviews            Review[]                   @relation("ProviderReviews")
  consentLogs        ConsentLog[]
  emailVerificationTokens EmailVerificationToken[]
  emailChangeTokens       EmailChangeToken[]
  emailLogs          EmailLog[]
  stations           Station[]
  workers            Worker[]
  workerTasks        WorkerTask[]
  serviceConfigs     ServiceConfig[]
  services                   Service[]
  addons                     Addon[]
  dataExportRequests         DataExportRequest[]
  notificationPreferences    NotificationPreferences?
  pushSubscriptions          PushSubscription[]
  depotSlots                 DepotSlot[]
  tireSets                   TireSet[]
  clients                    Client[]
  waitlistEntries            ProviderWaitlistEntry[]

  @@map("providers")
}

// ──────────────────────────────────────────────
// PROVIDER PHOTO
// ──────────────────────────────────────────────

enum PhotoType {
  LOGO
  VEHICLE
  WORKSPACE
  ADDITIONAL
}

model ProviderPhoto {
  id           String    @id @default(uuid()) @db.Uuid
  providerId   String    @db.Uuid
  provider     Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  url          String    @db.VarChar(500)
  storageKey   String    @db.VarChar(500)
  type         PhotoType
  isPrimary    Boolean   @default(false)
  size         Int
  mimeType     String    @db.VarChar(100)
  originalName String    @db.VarChar(255)
  createdAt    DateTime  @default(now())

  @@index([providerId])
  @@map("provider_photos")
}

// ──────────────────────────────────────────────
// SCHEDULE EXCEPTION — urlopy, święta
// ──────────────────────────────────────────────

model ScheduleException {
  id              String    @id @default(uuid()) @db.Uuid
  providerId      String    @db.Uuid
  date            DateTime  @db.Date
  reason          String    @db.VarChar(200)
  customOpenTime  DateTime? @db.Time(6)
  customCloseTime DateTime? @db.Time(6)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, date])
  @@map("schedule_exceptions")
}

// ──────────────────────────────────────────────
// BOOKING — serce systemu
// ──────────────────────────────────────────────

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  referenceCode   String        @unique @db.VarChar(10)
  clientId        String        @db.Uuid
  providerId      String        @db.Uuid
  vehicleId       String?       @db.Uuid
  status          BookingStatus @default(PENDING)
  startAt         DateTime
  endAt           DateTime
  // adres klienta (mobile provider)
  addressLine     String?       @db.VarChar(300)
  addressCity     String?       @db.VarChar(100)
  addressLat      Decimal?      @db.Decimal(9, 6)
  addressLng      Decimal?      @db.Decimal(9, 6)
  // snapshot cen z momentu rezerwacji (immutable po created)
  tireSize        String?       @db.VarChar(20)
  basePricePln    Decimal?      @db.Decimal(10, 2)
  travelFeePln    Decimal?      @db.Decimal(10, 2)
  totalPricePln   Decimal?      @db.Decimal(10, 2)
  // notatki i powody
  notes           String?       @db.Text
  clientNote      String?       @db.Text
  rejectReason    String?       @db.VarChar(500)
  cancelReason    String?       @db.VarChar(500)
  // timestamps
  createdAt       DateTime      @default(now())
  confirmedAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  stationId             String?       @db.Uuid
  workerId              String?       @db.Uuid
  serviceName           String?       @db.VarChar(300)
  serviceDetails        Json?
  isManual              Boolean       @default(false)
  isCustomService       Boolean       @default(false)
  customPricePln        Decimal?      @db.Decimal(10, 2)
  customDurationMinutes Int?
  reminderSentAt        DateTime?

  client      Client       @relation(fields: [clientId], references: [id])
  provider    Provider     @relation("ProviderBookings", fields: [providerId], references: [id])
  vehicle     Vehicle?     @relation("VehicleBookings", fields: [vehicleId], references: [id])
  station     Station?     @relation(fields: [stationId], references: [id])
  worker      Worker?      @relation(fields: [workerId], references: [id], onDelete: SetNull)
  review      Review?
  tireSets    TireSet[]
  workerTasks WorkerTask[]

  @@index([providerId, startAt])
  @@index([clientId])
  @@index([stationId])
  @@index([providerId, isCustomService, serviceName])
  // UWAGA: partial unique index zapobiegający double-booking dodany w migracji SQL:
  // CREATE UNIQUE INDEX bookings_no_double_booking
  //   ON bookings (provider_id, start_at)
  //   WHERE status IN ('PENDING','CONFIRMED','IN_PROGRESS');
  @@map("bookings")
}

// ──────────────────────────────────────────────
// REVIEW — ocena po rezerwacji
// ──────────────────────────────────────────────

model Review {
  id                String    @id @default(uuid()) @db.Uuid
  bookingId         String    @unique @db.Uuid
  clientId          String    @db.Uuid
  providerId        String    @db.Uuid
  rating            Int       // 1–5; CHECK (rating BETWEEN 1 AND 5) dodany w migracji SQL
  comment           String?   @db.Text
  providerReply     String?   @db.Text
  providerRepliedAt DateTime?
  isReported        Boolean   @default(false)
  isHidden          Boolean   @default(false)
  seenByProvider    Boolean   @default(false)
  editCount         Int       @default(0)
  lastEditedAt      DateTime?
  createdAt         DateTime  @default(now())

  booking  Booking  @relation(fields: [bookingId], references: [id])
  client   Client   @relation(fields: [clientId], references: [id])
  provider Provider @relation("ProviderReviews", fields: [providerId], references: [id])

  @@index([providerId, createdAt(sort: Desc)])
  @@map("reviews")
}

// ──────────────────────────────────────────────
// OTP TOKEN — weryfikacja telefonu (phone-keyed)
// ──────────────────────────────────────────────

model OtpToken {
  id        String    @id @default(uuid()) @db.Uuid
  phone     String    @db.VarChar(20)
  codeHash  String    @db.VarChar(200)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  @@index([phone, createdAt])
  @@index([phone, expiresAt])
  @@map("otp_tokens")
}

// ──────────────────────────────────────────────
// CONSENT LOG — RODO / regulamin
// ──────────────────────────────────────────────

model ConsentLog {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  providerId  String?     @db.Uuid
  consentType ConsentType
  version     String      @db.VarChar(20)
  accepted    Boolean
  ipAddress   String?     @db.VarChar(45)
  createdAt   DateTime    @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([userId, consentType])
  @@map("consent_logs")
}

// ──────────────────────────────────────────────
// WAITLIST — miasta poza zasięgiem v0
// ──────────────────────────────────────────────

model WaitlistSignup {
  id        String       @id @default(uuid()) @db.Uuid
  email     String       @db.VarChar(254)
  city      String       @db.VarChar(100)
  role      WaitlistRole
  createdAt DateTime     @default(now())

  @@unique([email, city, role])
  @@index([city, role])
  @@map("waitlist_signups")
}

// ──────────────────────────────────────────────
// PROVIDER WAITLIST — mobilni klienci oczekujący
// ──────────────────────────────────────────────

model ProviderWaitlistEntry {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  providerId String   @db.Uuid
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId])
  @@map("provider_waitlist_entries")
}

// ──────────────────────────────────────────────
// AUDIT LOG — log zmian statusów (soft audit)
// ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  entity    String   @db.VarChar(50)
  entityId  String   @db.VarChar(36)
  action    String   @db.VarChar(50)
  payload   Json
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

// ──────────────────────────────────────────────
// EMAIL VERIFICATION TOKEN
// ──────────────────────────────────────────────

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String    @db.Uuid
  email      String    @db.VarChar(254)
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("email_verification_tokens")
}

// ──────────────────────────────────────────────
// EMAIL CHANGE OTP
// ──────────────────────────────────────────────

model EmailChangeToken {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String    @db.Uuid
  newEmail   String    @db.VarChar(254)
  codeHash   String    @db.VarChar(200)
  expiresAt  DateTime
  usedAt     DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("email_change_tokens")
}

// ──────────────────────────────────────────────
// EMAIL LOG
// ──────────────────────────────────────────────

model EmailLog {
  id         String    @id @default(uuid()) @db.Uuid
  providerId String    @db.Uuid
  type       EmailType
  to         String    @db.VarChar(254)
  sentAt     DateTime  @default(now())
  error      String?   @db.Text

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, sentAt(sort: Desc)])
  @@map("email_logs")
}

// ──────────────────────────────────────────────
// SESSION — refresh-token rotation z detekcją kradzieży
// ──────────────────────────────────────────────

model Session {
  id         String    @id                       // = jti z JWT
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)   // SHA-256(refreshToken) hex
  userAgent  String?   @db.VarChar(500)
  ipAddress  String?   @db.VarChar(45)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, revokedAt])
  @@map("sessions")
}

// ──────────────────────────────────────────────
// STATION — fizyczne stanowisko warsztatu
// ──────────────────────────────────────────────

model Station {
  id         String        @id @default(uuid()) @db.Uuid
  providerId String        @db.Uuid
  name       String        @db.VarChar(100)
  serviceIds String[]      // IDs usług z modelu Service
  schedule   Json          // DaySchedule[] — grafik tygodniowy
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  provider   Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  workers    StationWorker[]
  bookings   Booking[]

  @@map("stations")
}

// ──────────────────────────────────────────────
// WORKER — pracownik warsztatu
// ──────────────────────────────────────────────

model Worker {
  id          String          @id @default(uuid()) @db.Uuid
  providerId  String          @db.Uuid
  name        String          @db.VarChar(100)
  role        String?         @db.VarChar(100)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  provider    Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  stations    StationWorker[]
  leaves      WorkerLeave[]
  bookings    Booking[]
  workerTasks WorkerTask[]

  @@map("workers")
}

// ──────────────────────────────────────────────
// STATION WORKER — powiązanie stanowisko ↔ pracownik
// ──────────────────────────────────────────────

model StationWorker {
  stationId  String  @db.Uuid
  workerId   String  @db.Uuid
  shiftStart String? @db.VarChar(5) // "08:00", null = cały grafik stanowiska
  shiftEnd   String? @db.VarChar(5) // "14:00"

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@id([stationId, workerId])
  @@index([workerId])
  @@map("station_workers")
}

// ──────────────────────────────────────────────
// WORKER LEAVE — urlopy / nieobecności
// ──────────────────────────────────────────────

model WorkerLeave {
  id        String    @id @default(uuid()) @db.Uuid
  workerId  String    @db.Uuid
  type      LeaveType
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  note      String?   @db.VarChar(500)
  createdAt DateTime  @default(now())

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@map("worker_leaves")
}

// ──────────────────────────────────────────────
// WORKER TASK — własne zadania warsztatu
// ──────────────────────────────────────────────

model WorkerTask {
  id              String    @id @default(uuid()) @db.Uuid
  providerId      String    @db.Uuid
  workerId        String?   @db.Uuid
  title           String    @db.VarChar(200)
  startAt         DateTime
  endAt           DateTime
  notes           String?   @db.Text
  linkedBookingId String?   @db.Uuid
  createdAt       DateTime  @default(now())

  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  worker        Worker?  @relation(fields: [workerId], references: [id], onDelete: SetNull)
  linkedBooking Booking? @relation(fields: [linkedBookingId], references: [id], onDelete: SetNull)

  @@index([providerId])
  @@index([providerId, startAt])
  @@map("worker_tasks")
}

// ──────────────────────────────────────────────
// SERVICE CONFIG — czas trwania usługi dla dostawcy
// ──────────────────────────────────────────────

model ServiceConfig {
  id              String      @id @default(uuid()) @db.Uuid
  providerId      String      @db.Uuid
  serviceType     ServiceType
  durationMinutes Int         @default(45)
  provider        Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceType])
  @@map("service_configs")
}

// ──────────────────────────────────────────────
// ──────────────────────────────────────────────
// SERVICES — lista usług warsztatu
// ──────────────────────────────────────────────

model Service {
  id          String             @id @default(uuid()) @db.Uuid
  providerId  String             @db.Uuid
  name        String             @db.VarChar(200)
  description String?            @db.VarChar(1000)
  pricingType ServicePricingType @default(FLAT)
  enabled     Boolean            @default(true)
  sortOrder   Int                @default(0)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  provider    Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  variants    ServiceVariant[]
  subLinks    ServiceSubLink[]   @relation("ParentService")
  parentLinks ServiceSubLink[]   @relation("SubService")
  addonLinks  ServiceAddonLink[]

  @@index([providerId])
  @@map("services")
}

model ServiceVariant {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @db.Uuid
  name            String?  @db.VarChar(200)  // null dla FLAT i RIM_SIZES
  rimSizes        String[]                    // tylko dla RIM_SIZES
  pricePln                Decimal  @db.Decimal(10, 2) // cena za komplet (4 koła)
  durationMinutes         Int                         // czas dla kompletu (4 koła)
  pricePerWheelPln        Decimal? @db.Decimal(10, 2) // null = pricePln / 4
  durationPerWheelMinutes Int?                        // null = durationMinutes / 4
  sortOrder       Int      @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@map("service_variants")
}

// Pod-usługi: cross-referencje między usługami (sugestie przy wizycie)
model ServiceSubLink {
  id        String @id @default(uuid()) @db.Uuid
  parentId  String @db.Uuid
  subId     String @db.Uuid
  sortOrder Int    @default(0)

  parent Service @relation("ParentService", fields: [parentId], references: [id], onDelete: Cascade)
  sub    Service @relation("SubService",    fields: [subId],    references: [id], onDelete: Cascade)

  @@unique([parentId, subId])
  @@index([parentId])
  @@map("service_sub_links")
}

// ──────────────────────────────────────────────
// ADDONS — kolekcja dodatków do usług
// ──────────────────────────────────────────────

model Addon {
  id              String    @id @default(uuid()) @db.Uuid
  providerId      String    @db.Uuid
  name            String    @db.VarChar(200)
  pricePln        Decimal   @db.Decimal(10, 2)
  durationMinutes Int?
  enabled         Boolean   @default(true)
  sortOrder       Int       @default(0)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  provider Provider          @relation(fields: [providerId], references: [id], onDelete: Cascade)
  links    ServiceAddonLink[]

  @@index([providerId])
  @@map("addons")
}

model ServiceAddonLink {
  serviceId String @db.Uuid
  addonId   String @db.Uuid
  sortOrder Int    @default(0)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  addon   Addon   @relation(fields: [addonId],   references: [id], onDelete: Cascade)

  @@id([serviceId, addonId])
  @@map("service_addon_links")
}

// ──────────────────────────────────────────────
// PUSH SUBSCRIPTION — Web Push subskrypcje urządzeń
// ──────────────────────────────────────────────

model PushSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  providerId String   @db.Uuid
  endpoint   String   @db.Text
  p256dh     String   @db.VarChar(500)
  auth       String   @db.VarChar(100)
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, endpoint])
  @@index([providerId])
  @@map("push_subscriptions")
}

// ──────────────────────────────────────────────
// NOTIFICATION PREFERENCES — per-provider, per-channel ustawienia
// ──────────────────────────────────────────────

model NotificationPreferences {
  id              String  @id @default(uuid()) @db.Uuid
  providerId      String  @unique @db.Uuid

  newBookingSms   Boolean @default(true)
  newBookingEmail Boolean @default(false)
  newBookingPush  Boolean @default(true)

  cancelationSms   Boolean @default(true)
  cancelationEmail Boolean @default(false)
  cancelationPush  Boolean @default(true)

  reminder30Sms   Boolean @default(true)
  reminder30Email Boolean @default(false)
  reminder30Push  Boolean @default(true)

  newReviewSms   Boolean @default(false)
  newReviewEmail Boolean @default(true)
  newReviewPush  Boolean @default(true)

  weeklyReportSms   Boolean @default(false)
  weeklyReportEmail Boolean @default(true)
  weeklyReportPush  Boolean @default(false)

  platformNewsSms   Boolean @default(false)
  platformNewsEmail Boolean @default(false)
  platformNewsPush  Boolean @default(false)

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ──────────────────────────────────────────────
// DATA EXPORT REQUEST — wnioski RODO „pobierz moje dane"
// ──────────────────────────────────────────────

model DataExportRequest {
  id          String           @id @default(uuid()) @db.Uuid
  providerId  String           @db.Uuid
  status      DataExportStatus @default(PENDING)
  requestedAt DateTime         @default(now())
  completedAt DateTime?

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status, requestedAt])
  @@map("data_export_requests")
}

// ──────────────────────────────────────────────
// DEPOT — skład opon
// ──────────────────────────────────────────────

model DepotSlot {
  id         String  @id @default(uuid()) @db.Uuid
  providerId String  @db.Uuid
  section    String  @db.VarChar(10)
  row        Int
  position   Int
  label      String? @db.VarChar(50)

  provider Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tireSets TireSet[]

  @@unique([providerId, section, row, position])
  @@index([providerId])
  @@map("depot_slots")
}

model TireSet {
  id          String @id @default(uuid()) @db.Uuid
  providerId  String @db.Uuid
  clientId    String @db.Uuid

  vehicleName  String? @db.VarChar(100)
  licensePlate String? @db.VarChar(20)

  brand        String?        @db.VarChar(100)
  model        String?        @db.VarChar(100)
  tireSize     String         @db.VarChar(20)
  tireType     TireType
  isOnRims     Boolean        @default(true)
  dotCode      String?        @db.VarChar(20)
  treadDepthMm Float?
  condition    TireCondition  @default(GOOD)

  slotId String? @db.Uuid

  status TireSetStatus @default(IN_DEPOT)

  storagePricePln Decimal? @db.Decimal(10, 2)

  sourceBookingId String? @db.Uuid

  notes     String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider      Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  client        Client          @relation(fields: [clientId], references: [id])
  slot          DepotSlot?      @relation(fields: [slotId], references: [id])
  sourceBooking Booking?        @relation(fields: [sourceBookingId], references: [id])
  periods       StoragePeriod[]

  @@index([clientId])
  @@index([providerId, status])
  @@index([providerId, clientId])
  @@map("tire_sets")
}

model StoragePeriod {
  id         String    @id @default(uuid()) @db.Uuid
  tireSetId  String    @db.Uuid
  storedAt   DateTime
  releaseDue DateTime?
  pickedUpAt DateTime?
  pricePln   Decimal?  @db.Decimal(10, 2)
  notes      String?   @db.Text

  tireSet TireSet @relation(fields: [tireSetId], references: [id], onDelete: Cascade)

  @@index([tireSetId])
  @@map("storage_periods")
}

// ── Concurrency: idempotency keys ─────────────────────────────────────────
// Stores the result of POST requests for 5 minutes so retries return the
// same response without creating duplicate bookings.

model IdempotencyKey {
  // scopedKey = "<userId>:<client-supplied UUID>"
  scopedKey   String   @id @db.VarChar(200)
  payloadHash String   @db.VarChar(64)  // SHA-256 of request body
  statusCode  Int
  response    Json
  expiresAt   DateTime

  @@index([expiresAt])
  @@map("idempotency_keys")
}
