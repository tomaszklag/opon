DATABASE_URL=postgresql://opony:opony_dev_password@localhost:5432/opony_dev
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
PANEL_URL=http://localhost:3001
APP_URL=http://localhost:4000

# JWT — generuj: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changeme_jwt_secret_here
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_here
ADMIN_JWT_SECRET=changeme_admin_jwt_here

# SMS (Twilio)
TWILIO_SID=placeholder
TWILIO_AUTH_TOKEN=placeholder
TWILIO_PHONE=placeholder
TWILIO_MOCK=true

# Email (Resend)
RESEND_API_KEY=placeholder
RESEND_FROM_EMAIL=noreply@opony.app

# Storage (AWS S3)
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_S3_BUCKET=opony-uploads
AWS_REGION=eu-central-1

# Maps
GOOGLE_MAPS_API_KEY=placeholder

# GUS (weryfikacja NIP)
GUS_API_KEY=placeholder
GUS_BASE_URL=https://dane.biznes.gov.pl/api/ceidg/v3

# Monitoring
SENTRY_DSN_API=placeholder

# Web Push (VAPID) — generuj: cd apps/api && npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=placeholder
VAPID_PRIVATE_KEY=placeholder
VAPID_SUBJECT=mailto:kontakt@opony.app

# Feature flags
CLIENT_LAUNCH_DATE=2026-05-14
