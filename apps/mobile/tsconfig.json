{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@opony/design-system-native": ["../../packages/design-system-native/src/index.ts"],
      "@opony/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@opony/api-client": ["../../packages/api-client/src/index.ts"],
      "@opony/shared-types": ["../../packages/shared-types/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules"]
}
